<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.scrob" name="Scrob" version="1.0.0" provider-name="Scrob">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="login"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Scrobble plays to your Scrob instance</summary>
    <description lang="en_GB">Automatically tracks movies and TV shows in your self-hosted Scrob instance as you watch them in Kodi.</description>
    <platform>all</platform>
    <license>GPL-3.0-only</license>
    <source>https://github.com/ellite/scrob-kodi</source>
    <news>
1.0.0
- Initial release
    </news>
  </extension>
</addon>
